[Unit]
Description=Create and verify an M010.028 R8 managed Repo Control SQLite snapshot on the NAS
After=network-online.target remote-fs.target
RequiresMountsFor=/mnt/nas/repo-control

[Service]
Type=oneshot
User=chuck
Group=chuck
WorkingDirectory=/home/chuck/projects/repo-control-ii
EnvironmentFile=/etc/repo-control/backup-m010028-r8.env
ExecStart=/home/chuck/.venvs/repo-control-python-3.12.16-sqlite-3.51.3/bin/python -m repoctl.backup backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/repo-control-staging/m010.028-r8/prepared/managed-prepared.sqlite3 -/var/lib/repo-control-staging/m010.028-r8/prepared/managed-prepared.sqlite3-wal /var/lib/repo-control-staging/m010.028-r8/state
ReadWritePaths=/var/lib/repo-control-staging/m010.028-r8/prepared/managed-prepared.sqlite3-shm /var/lib/repo-control-staging/m010.028-r8/state/.locks /home/chuck/.local/state/repo-control-backup/staging/m010.028-r8 /mnt/nas/repo-control/RepoControl/repo-control-ii
