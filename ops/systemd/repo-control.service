[Unit]
Description=Repo Control browser service
After=network.target

[Service]
Type=simple
User=chuck
WorkingDirectory=/home/chuck/projects/repo-control-ii
EnvironmentFile=/etc/repo-control/backup.env
ExecStart=/home/chuck/.venvs/repo-control-python-3.12.16-sqlite-3.51.3-m010014-clean/bin/python -m repoctl.cli web --repository-registry /home/chuck/projects/repo-control-ii/ops/repositories.toml --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
