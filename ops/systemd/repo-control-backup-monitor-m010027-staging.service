[Unit]
Description=Check M010.027 staged Repo Control NAS backup coverage
After=network-online.target

[Service]
Type=oneshot
User=chuck
Group=chuck
WorkingDirectory=/home/chuck/projects/repo-control-ii
EnvironmentFile=/etc/repo-control/backup-m010027-staging.env
ExecStart=/home/chuck/.venvs/repo-control-python-3.12.16-sqlite-3.51.3/bin/python -m repoctl.backup monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/mnt/nas/repo-control /var/lib/repo-control-staging/m010.027/prepared/managed-prepared.sqlite3 -/var/lib/repo-control-staging/m010.027/prepared/managed-prepared.sqlite3-wal /var/lib/repo-control-staging/m010.027/state
ReadWritePaths=/var/lib/repo-control-staging/m010.027/prepared/managed-prepared.sqlite3-shm /var/lib/repo-control-staging/m010.027/state/.locks
