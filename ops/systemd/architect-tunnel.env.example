# Environment configuration for repo-control-architect-tunnel.service
# Store this file outside the repository with restricted permissions (e.g. chmod 600)
# Default search locations:
#   - /etc/repo-control/architect-tunnel.env (system-wide)
#   - ~/.config/repo-control/tunnel.env (user-level)

# Restricted runtime OpenAI API key (Tunnels: Read + Use permissions only)
CONTROL_PLANE_API_KEY=sk-...

# Tunnel ID provisioned in OpenAI Platform settings associated with ChatGPT workspace
CONTROL_PLANE_TUNNEL_ID=tunnel_...
