[Unit]
Description=Execute one sealed Repo Control procedure request for %i
After=repo-control.service

[Service]
Type=oneshot
User=chuck
Group=chuck
WorkingDirectory=/home/chuck/projects/repo-control-ii
Environment=REPOCTL_PROCEDURE_TRANSACTION_ROOT=/home/chuck/.local/share/.repoctl-procedure-transactions
ExecStart=/home/chuck/.venvs/repo-control-python-3.12.16-sqlite-3.51.3/bin/python -m repoctl.cli procedure-execute-request --repository-key %i --repository-registry /home/chuck/projects/repo-control-ii/ops/repositories.toml --state-root /var/lib/repo-control-staging/m010.028-r8/state --transaction-root /home/chuck/.local/share/.repoctl-procedure-transactions --runtime-health-url http://127.0.0.1:8765/healthz
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/chuck/.local/share/.repoctl-procedure-transactions
ReadWritePaths=/var/lib/repo-control-staging/m010.028-r8/state/.locks
