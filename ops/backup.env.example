# Non-secret M010.020 path values for review; the host operator provisions the
# root-owned /etc/repo-control/backup.env separately. Do not use it for backup
# writes until the NAS ACL boundary is verified.
# Keep CIFS credentials in a separate root-owned file. This example does not
# authorize unit installation, backup writes, or service changes.
REPOCTL_BACKUP_SOURCE=/home/chuck/.local/share/repoctl-sqlite/repo-control-ii/information-store.sqlite3
REPOCTL_BACKUP_STAGING=/home/chuck/.local/state/repo-control-backup/staging
REPOCTL_BACKUP_DESTINATION=/mnt/nas/repo-control/RepoControl/repo-control-ii
REPOCTL_BACKUP_RESTORE_ROOT=/home/chuck/.local/state/repo-control-backup/restore
REPOCTL_BACKUP_MOUNTPOINT=/mnt/nas/repo-control
REPOCTL_BACKUP_MOUNT_SOURCE=//192.168.1.171/ProjectBackups
REPOCTL_BACKUP_COVERAGE_PATH=/home/chuck/.local/state/repo-control-backup/staging/.repoctl-verified-recovery-point.json
REPOCTL_BACKUP_REPOSITORY_ID=repo-control-ii--945e7f88eafb
REPOCTL_BACKUP_REPOSITORY_KEY=repo-control-ii
REPOCTL_BACKUP_REPOSITORY_ROOT=/home/chuck/projects/repo-control-ii
REPOCTL_BACKUP_MAX_AGE_SECONDS=1200
